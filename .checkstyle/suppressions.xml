<!DOCTYPE suppressions PUBLIC "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "http://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- no javadoc on test and non-api classes -->
    <suppress files="src[\\/]test[\\/]java[\\/].*" checks="(FilteringWriteTag|JavadocPackage|MissingJavadoc.*)"/>
    <suppress files=".*[\\/]src[\\/]main[\\/]java[\\/].*Impl.java"
              checks="(FilteringWriteTag|JavadocPackage|MissingJavadoc.*)"/>

    <!-- event & exception methods don't need javadoc -->
    <suppress files="src[\\/].*[\\/]java[\\/].*Event" checks="MissingJavadocMethod"/>
    <suppress files="src[\\/].*[\\/]java[\\/].*Exception" checks="MissingJavadocMethod"/>

    <!-- no checkstyle on build -->
    <suppress files="build[\\/].*" checks=".*"/>

    <!-- no package JD on multirelease variants -->
    <suppress files="src[\\/]main[\\/]java\d+[\\/].*" checks="JavadocPackage"/>
</suppressions>
